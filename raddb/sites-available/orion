# Servidor RADIUS do Orion (PPPoE: PAP, CHAP, MS-CHAP; IPoE: MAC do cliente no pedido do DHCP).
server orion {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		# NAS efetivo: a IP de origem (túnel) ou, pelo respaldo da IP pública, o NAS-IP-Address
		# (IP do túnel) desde que a IP pública seja a desse NAS. As consultas usam Tmp-String-6.
		if ("%{sql:SELECT 1 FROM orion.nas WHERE nasname = '%{Packet-Src-IP-Address}'}" == "1") {
			update request {
				&Tmp-String-6 := "%{Packet-Src-IP-Address}"
			}
		}
		elsif (&NAS-IP-Address && "%{sql:SELECT 1 FROM orion.nas WHERE nasname = '%{NAS-IP-Address}' AND publica = '%{Packet-Src-IP-Address}'}" == "1") {
			update request {
				&Tmp-String-6 := "%{NAS-IP-Address}"
			}
		}
		else {
			reject
		}
		# IPoE: pedido do servidor DHCP do MikroTik (use-radius). Chega com User-Name = MAC do
		# cliente e senha vazia, sem PPP, sem Service-Type e sem CHAP/MS-CHAP/EAP. Só um pedido
		# assim pode usar a conta IPoE da MAC (que não tem senha): as consultas recebem
		# Tmp-String-5 = "ipoe". Qualquer outro pedido (PPPoE, login, hotspot, wireless) com uma
		# MAC como usuário continua valendo só para contas PPPoE, com senha.
		if (!&Framed-Protocol && !&Service-Type && !&CHAP-Password && !&MS-CHAP-Challenge && !&EAP-Message \
		    && (!&User-Password || (&User-Password == "")) \
		    && (&User-Name =~ /^[0-9A-Fa-f]{2}([:.-]?[0-9A-Fa-f]{2}){5}$/)) {
			update request {
				&Tmp-String-5 := "ipoe"
			}
		}
		# Sem filter_username: a política padrão rejeita usuário com realm sem
		# ponto ("cliente@madenet"), formato comum nos ISP (MikroWisp etc.).
		# O usuário só é usado como parâmetro escapado nas consultas SQL.
		preprocess
		chap
		mschap
		sql
		# Usuário inexistente, de outro ISP, cancelado ou sem senha: rejeita.
		if (notfound) {
			reject
		}
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
		Auth-Type MS-CHAP {
			mschap
		}
	}

	preacct {
		# NAS efetivo: a IP de origem (túnel) ou, pelo respaldo da IP pública, o NAS-IP-Address
		# (IP do túnel) desde que a IP pública seja a desse NAS. As consultas usam Tmp-String-6.
		if ("%{sql:SELECT 1 FROM orion.nas WHERE nasname = '%{Packet-Src-IP-Address}'}" == "1") {
			update request {
				&Tmp-String-6 := "%{Packet-Src-IP-Address}"
			}
		}
		elsif (&NAS-IP-Address && "%{sql:SELECT 1 FROM orion.nas WHERE nasname = '%{NAS-IP-Address}' AND publica = '%{Packet-Src-IP-Address}'}" == "1") {
			update request {
				&Tmp-String-6 := "%{NAS-IP-Address}"
			}
		}
		preprocess
		acct_unique
	}

	accounting {
		sql
	}

	post-auth {
		sql
		Post-Auth-Type REJECT {
			sql
			attr_filter.access_reject
		}
	}
}
