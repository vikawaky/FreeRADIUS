# Conexão com o banco do FreeRADIUS (Postgres separado do Supabase).
# As tabelas e funções do schema `orion` são criadas e mantidas pelo worker
# radius-sync do Orion (repositório vikawaky/orion-isp, worker/radius-sync).
sql {
	dialect = "postgresql"
	driver = "rlm_sql_${dialect}"

	postgresql {
		send_application_name = yes
	}

	server = "$ENV{DB_HOST}"
	port = $ENV{DB_PORT}
	login = "$ENV{DB_USER}"
	password = "$ENV{DB_PASSWORD}"
	radius_db = "$ENV{DB_NAME}"

	# Sem grupos nem perfis: cada conta já traz a resposta completa.
	read_groups = no
	read_profiles = no
	# NAS: lidos sob demanda pelo servidor dynamic_clients (sem reiniciar).
	read_clients = no
	client_table = "orion.nas"
	group_attribute = "SQL-Group"

	pool {
		start = 1
		min = 1
		max = 16
		spare = 4
		uses = 0
		retry_delay = 5
		lifetime = 0
		idle_timeout = 60
	}

	$INCLUDE ${confdir}/mods-config/orion-queries.conf
}
